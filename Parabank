def test_navigation(login_in_page: Page):
    page=login_in_page
    a = ["About Us", "Services", "Products", "locations", "Admin Page"]

    for l in a:
        page.locator("#headerPanel").get_by_role("link", name=l).click()
        page.go_back()

    b =["Open New Account","Accounts Overview","Transfer Funds","Bill Pay","Find Transactions","Update Contact Info","Request Loan","Log Out"]

    for l1 in b:
        page.get_by_role("link",name=l1).click()

