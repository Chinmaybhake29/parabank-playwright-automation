@pytest.fixture
def page_context():
    with sync_playwright() as p:
        browser=p.chromium.launch(headless=False)
        context=browser.new_context()
        context.tracing.start(screenshots=True, snapshots=True, sources=True)
        page=context.new_page()
        yield page
        context.tracing.stop(path="website2.zip")
        context.close()
        browser.close()

def test_register(page_context : Page):
    page=page_context
    page.goto(URL)
    page.get_by_role("link", name="Register").click()
    page.locator('[id="customer.firstName"]').fill("krish11")
    page.locator('[id="customer.lastName"]').fill("krish11")
    page.locator('[id="customer.address.street"]').fill(address)
    page.locator('[id="customer.address.city"]').fill(city)
    page.locator('[id="customer.address.state"]').fill(state)
    page.locator('[id="customer.address.zipCode"]').fill(zip_code)
    page.locator('[id="customer.phoneNumber"]').fill(phone_number)
    page.locator('[id="customer.ssn"]').fill("110")
    page.locator('[id="customer.username"]').fill(USERNAME)
    page.locator('[id="customer.password"]').fill(PASSWORD)
    page.locator("#repeatedPassword").fill(PASSWORD)
    page.get_by_role("button", name="Register").click()
    expect(page.get_by_role("heading", name="welcome")).to_be_visible()
    expect(page.locator("p", has_text="Your account was created successfully. You are now logged in."))

